{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "engine", "run", "api"],
      "port": 3123
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 2627,
      "autoPort": true
    },
    {
      "name": "web-public",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "VITE_APP_MODE=public PORT=2628 npm --prefix web run dev"],
      "port": 2628
    }
  ]
}
